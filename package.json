{
  "name": "flt-attendance",
  "productName": "福拉特考勤统计",
  "version": "0.1.11",
  "description": "离线钉钉考勤统计工具",
  "author": "FLT Attendance",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/main/index.js",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "update:holidays": "node scripts/update-holidays.mjs",
    "build:native": "npm run update:holidays && node scripts/build-native.mjs",
    "dev": "npm run build:native && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-vite dev --outDir=dist",
    "start": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-vite preview --outDir=dist",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:electron": "electron-vite build --outDir=dist",
    "build": "npm run typecheck && npm run build:native && npm run build:electron",
    "package": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-forge package",
    "make": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "7.0.3",
    "electron": "43.1.1",
    "electron-vite": "5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.28.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
